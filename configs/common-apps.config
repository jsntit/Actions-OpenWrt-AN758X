# ===========================================================
# 公共插件配置：对分支内所有设备（含 profile=all）统一生效
# 由工作流「Load custom configuration」步骤在 .config 基座打底、
# 机型 config 追加之后统一 cat 注入，不再局限于单机型 config。
#
# 依赖说明：
#   - gecoosac / luci-app-gecoosac 由 diy-part1.sh (ADD_GECOOSAC=true)
#     全局 clone 到 package/custom，此处仅勾选；
#   - frpc / homeproxy / tailscale-community 来自标准 immortalwrt/luci
#     feed，随 feeds install 全局可用，此处仅勾选。
# 若某设备 config 中显式写了 "# CONFIG_PACKAGE_xxx is not set"，
# 会覆盖此处（后写覆盖先写），仍可按机型单独排除。
# ===========================================================
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn=y
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y
CONFIG_PACKAGE_gecoosac=y
